{
  "name": "@alexpricedev/billet-dialog",
  "version": "0.2.0",
  "description": "Accessible dialogs for the server-rendered web: a confirm prompt for destructive actions, and progressive-enhancement upgrading for dialogs your templates render. Native <dialog>, zero dependencies, scoped CSS tokens.",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target browser --format esm && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT",
  "author": "Alex Price",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpricedev/billet-dialog.git"
  },
  "bugs": {
    "url": "https://github.com/alexpricedev/billet-dialog/issues"
  },
  "homepage": "https://github.com/alexpricedev/billet-dialog#readme",
  "keywords": [
    "dialog",
    "confirm",
    "modal",
    "alertdialog",
    "accessibility",
    "progressive-enhancement",
    "billet",
    "bun"
  ],
  "devDependencies": {
    "@happy-dom/global-registrator": "^21",
    "@types/bun": "latest",
    "happy-dom": "^21",
    "typescript": "^5.4.0"
  }
}
